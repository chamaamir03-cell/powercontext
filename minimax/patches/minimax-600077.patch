+++ b/minimax/sdd/context.py
@@ -0,0 +1,228 @@
+from __future__ import annotations
+
+import json
+import re
+from typing import Any
+
+from .config import REQUIRED_DOC_IDS, REQUIRED_SOURCES, TASK_ID
+from .store import Document, EngineeringStore
+
+_SPEC_VERSION = re.compile(r"SPEC_VERSION:\s*(\S+)")
+_TOKEN = re.compile(r"[A-Za-z][A-Za-z0-9_]{2,}")
+_STOP = {
+    "the",
+    "and",
+    "for",
+    "with",
+    "from",
+    "this",
+    "that",
+    "add",
+    "keep",
+    "make",
+    "into",
+    "when",
+    "must",
+    "should",
+    "will",
+    "have",
+    "test",
+}
+_FIXED_TERMS = (
+    "min_price",
+    "max_price",
+    "price",
+    "filter",
+    "inventory",
+    "search",
+    "spec",
+    "regression",
+    "pagination",
+    "bounds",
+    "validation",
+)
+
+
+class ContextError(RuntimeError):
+    pass
+
+
+def task_terms(task: str) -> list[str]:
+    terms = list(_FIXED_TERMS)
+    for match in _TOKEN.findall(task.lower()):
+        if match not in _STOP and match not in terms:
+            terms.append(match)
+    return terms
+
+
+class ContextBuilder:
+    def __init__(self, store: EngineeringStore, *, seekdb_label: str) -> None:
+        self.store = store
+        self.seekdb_label = seekdb_label
+
+    def build(self, task: str, state_info: dict[str, Any], state: dict[str, Any]) -> dict[str, Any]:
+        terms = task_terms(task)
+        ranked = {
+            "spec": self.store.search("spec", terms, limit=3),
+            "code": self.store.search("code", terms, limit=3),
+            "test": self.store.search("test", terms, limit=4),
+        }
+        required: dict[str, list[Document]] = {}
+        missing: list[str] = []
+        for kind, doc_ids in REQUIRED_DOC_IDS.items():
+            required[kind] = []
+            for doc_id in doc_ids:
+                document = self.store.get(doc_id)
+                if document is None:
+                    missing.append(doc_id)
+                else:
+                    required[kind].append(document)
+        if missing:
+            raise ContextError(
+                "Required documents are missing from seekdb; run `init` first. Missing: "
+                + ", ".join(missing)
+            )
+
+        sources: list[dict[str, Any]] = []
+        seen: set[str] = set()
+        for kind in ("spec", "code", "test"):
+            for document in required[kind]:
+                if document.doc_id in seen:
+                    continue
+                seen.add(document.doc_id)
+                sources.append(self._source(document, reason=f"required:{kind}", score=100.0))
+            for document in ranked[kind]:
+                if document.doc_id in seen:
+                    continue
+                seen.add(document.doc_id)
+                sources.append(self._source(document, reason="ranked", score=10.0))
+        specs = [self._source(document, reason="required:spec", score=100.0) for document in required["spec"]]
+        code = [self._source(document, reason="required:code", score=100.0) for document in required["code"]]
+        tests = [self._source(document, reason="required:test", score=100.0) for document in required["test"]]
+        spec_marker = None
+        if required["spec"]:
+            match = _SPEC_VERSION.search(required["spec"][0].content)
+            spec_marker = match.group(1) if match else None
+
+        documents: dict[str, Document] = {}
+        for kind in ("spec", "code", "test"):
+            for document in [*required[kind], *ranked[kind]]:
+                documents[document.doc_id] = document
+        context: dict[str, Any] = {
+            "_documents": documents,
+            "task": task,
+            "task_id": TASK_ID,
+            "required_sources": list(REQUIRED_SOURCES),
+            "missing_required": missing,
+            "specs": specs,
+            "code": code,
+            "tests": tests,
+            "sources": sources,
+            "state_before": state_info.get("state"),
+            "task_state": state,
+            "powercontext": {
+                "scope_id": state_info.get("scope_id"),
+                "prepared_status": state_info.get("prepared_status"),
+                "prepared_bytes": state_info.get("prepared_bytes"),
+                "prepared_contains_state": state_info.get("prepared_contains_state"),
+                "state_entries": state_info.get("entry_count", 0),
+            },
+            "db": {
+                "backend": "seekdb",
+                "database": self.seekdb_label,
+                "queries": self.store.queries,
+            },
+            "spec_marker": spec_marker,
+            "spec_version": required["spec"][0].version if required["spec"] else None,
+        }
+        context["context_text"] = render_context(context)
+        return context
+
+    @staticmethod
+    def _source(document: Document, *, reason: str, score: float) -> dict[str, Any]:
+        return {
+            "doc_id": document.doc_id,
+            "kind": document.kind,
+            "path": document.path,
+            "title": document.title,
+            "version": document.version,
+            "symbols": document.symbols,
+            "reason": reason,
+            "score": score,
+            "imported_from": document.metadata.get("imported_from"),
+            "excerpt": document.content[:700],
+        }
+
+
+def render_context(context: dict[str, Any]) -> str:
+    parts = [
+        "# SDD task context",
+        "",
+        f"Task: {context['task']}",
+        "",
+        "The specifications, code, and tests below were selected from seekdb.",
+        "The task state was loaded from PowerContext.",
+        "",
+        "## Specifications",
+    ]
+    for item in context["specs"]:
+        parts.extend(
+            [
+                "",
+                f"### {item['path']} (version {item['version']})",
+                _full_text(context, item["doc_id"]),
+            ]
+        )
+    parts.extend(["", "## Code"])
+    for item in context["code"]:
+        parts.extend(
+            [
+                "",
+                f"### {item['path']} (symbols: {', '.join(item['symbols']) or 'n/a'})",
+                "```python",
+                _full_text(context, item["doc_id"]),
+                "```",
+            ]
+        )
+    parts.extend(["", "## Tests"])
+    for item in context["tests"]:
+        parts.extend(
+            [
+                "",
+                f"### {item['path']}",
+                "```python",
+                _full_text(context, item["doc_id"]),
+                "```",
+            ]
+        )
+    parts.extend(
+        [
+            "",
+            "## Saved task state (PowerContext)",
+            "```json",
+            json.dumps(context["task_state"], ensure_ascii=False, indent=2, sort_keys=True),
+            "```",
+            "",
+            "## Required source paths",
+            *[f"- {path}" for path in context["required_sources"]],
+        ]
+    )
+    return "\n".join(parts)
+
+
+def _full_text(context: dict[str, Any], doc_id: str) -> str:
+    # The full content is carried by the store lookup that produced the hit.
+    # ContextBuilder stores excerpts only; resolve from the source document map.
+    sources = context.get("_documents", {})
+    document = sources.get(doc_id)
+    return document.content if document is not None else ""
+
+
+def attach_full_documents(context: dict[str, Any], documents: dict[str, Document]) -> dict[str, Any]:
+    context["_documents"] = documents
+    context["context_text"] = render_context(context)
+    return context
+
+
+def public_context(context: dict[str, Any]) -> dict[str, Any]:
+    return {key: value for key, value in context.items() if not key.startswith("_")}
diff --git a/minimax/sdd/minimax_client.py b/minimax/sdd/minimax_client.py
new file mode 100644
index 0000000..7e43074
--- /dev/null
+++ b/minimax/sdd/minimax_client.py
@@ -0,0 +1,183 @@
+from __future__ import annotations
+
+import difflib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+
+class MiniMaxError(RuntimeError):
+    pass
+
+
+def _run(command: list[str], *, cwd: Path, stdin: str | None = None, timeout: int = 900) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        command,
+        cwd=str(cwd),
+        input=stdin,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        errors="replace",
+        timeout=timeout,
+    )
+
+
+def apply_replay(workspace: Path, patch_path: Path) -> dict[str, Any]:
+    if not workspace.is_dir():
+        raise MiniMaxError(f"workspace does not exist: {workspace}")
+    if not patch_path.is_file():
+        raise MiniMaxError(f"patch does not exist: {patch_path}")
+    git = shutil.which("git")
+    if git:
+        check = _run([git, "apply", "--check", str(patch_path)], cwd=workspace, timeout=60)
+        if check.returncode != 0:
+            raise MiniMaxError(f"git apply --check failed: {check.stderr.strip()}")
+        applied = _run([git, "apply", str(patch_path)], cwd=workspace, timeout=60)
+        if applied.returncode != 0:
+            raise MiniMaxError(f"git apply failed: {applied.stderr.strip()}")
+        return {"mode": "replay", "patch": str(patch_path), "returncode": applied.returncode}
+    patch = shutil.which("patch")
+    if not patch:
+        raise MiniMaxError("neither git nor patch is available")
+    with patch_path.open("r", encoding="utf-8") as handle:
+        applied = subprocess.run(
+            [patch, "-p1"],
+            cwd=str(workspace),
+            stdin=handle,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+            timeout=60,
+        )
+    if applied.returncode != 0:
+        raise MiniMaxError(f"patch failed: {applied.stderr.strip()}")
+    return {"mode": "replay", "patch": str(patch_path), "returncode": applied.returncode}
+
+
+def _mcode_command() -> list[str]:
+    configured = os.environ.get("MCODE_BIN")
+    candidates: list[str] = []
+    if configured:
+        candidates.append(configured)
+    for name in ("mcode", "mcode.cmd"):
+        found = shutil.which(name)
+        if found:
+            candidates.append(found)
+    appdata = os.environ.get("APPDATA")
+    if appdata:
+        fallback = Path(appdata) / "npm" / "node_modules" / "@minimax-ai" / "code" / "cli.js"
+        if fallback.is_file():
+            candidates.append(str(fallback))
+    for candidate in candidates:
+        path = Path(candidate)
+        if path.suffix.lower() == ".js":
+            node = shutil.which("node") or "node"
+            return [node, str(path)]
+        if path.suffix.lower() in {".cmd", ".bat"}:
+            return ["cmd.exe", "/c", str(path)]
+        if path.is_file():
+            return [str(path)]
+    raise MiniMaxError(
+        "MiniMax Code CLI not found. Install it, run `mcode login --region cn`, "
+        "or set MCODE_BIN to the CLI path."
+    )
+
+
+def apply_live(
+    workspace: Path,
+    prompt: str,
+    records_dir: Path,
+    *,
+    timeout: str = "10m",
+    max_steps: int = 30,
+) -> dict[str, Any]:
+    if not workspace.is_dir():
+        raise MiniMaxError(f"workspace does not exist: {workspace}")
+    records_dir.mkdir(parents=True, exist_ok=True)
+    prompt_path = records_dir / "minimax_prompt.txt"
+    prompt_path.write_text(prompt, encoding="utf-8")
+    command = [
+        *_mcode_command(),
+        "exec",
+        "--cwd",
+        str(workspace),
+        "--permission",
+        "full",
+        "--output-format",
+        "json",
+        "--timeout",
+        timeout,
+        "--max-steps",
+        str(max_steps),
+        "--output-last-message",
+        str(records_dir / "minimax_last_message.md"),
+        "--input",
+        "-",
+    ]
+    started = time.time()
+    completed = _run(command, cwd=workspace, stdin=prompt, timeout=1200)
+    duration = time.time() - started
+    (records_dir / "minimax_response.json").write_text(completed.stdout, encoding="utf-8")
+    (records_dir / "minimax_stderr.log").write_text(completed.stderr, encoding="utf-8")
+    log = {
+        "command": command,
+        "cwd": str(workspace),
+        "returncode": completed.returncode,
+        "duration_seconds": round(duration, 3),
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "prompt_path": str(prompt_path),
+        "stdout_path": str(records_dir / "minimax_response.json"),
+        "stderr_path": str(records_dir / "minimax_stderr.log"),
+    }
+    (records_dir / "minimax_live.log").write_text(
+        json.dumps(log, ensure_ascii=False, indent=2), encoding="utf-8"
+    )
+    if completed.returncode != 0:
+        raise MiniMaxError(
+            f"MiniMax exec failed with exit code {completed.returncode}; see "
+            f"{records_dir / 'minimax_stderr.log'}"
+        )
+    _write_live_patch(workspace, records_dir / "live.patch")
+    return {"mode": "live", **log}
+
+
+def _write_live_patch(workspace: Path, patch_path: Path) -> None:
+    before = Path(__file__).resolve().parents[1] / "baseline" / "inventory" / "search.py"
+    after = workspace / "inventory" / "search.py"
+    if not before.is_file() or not after.is_file():
+        return
+    patch = "".join(
+        difflib.unified_diff(
+            before.read_text(encoding="utf-8").splitlines(keepends=True),
+            after.read_text(encoding="utf-8").splitlines(keepends=True),
+            fromfile="a/inventory/search.py",
+            tofile="b/inventory/search.py",
+            n=3,
+        )
+    )
+    patch_path.write_text(patch, encoding="utf-8", newline="\n")
+
+
+def apply(
+    mode: str,
+    workspace: Path,
+    *,
+    patch_path: Path,
+    records_dir: Path,
+    prompt: str | None = None,
+) -> dict[str, Any]:
+    if mode == "replay":
+        return apply_replay(workspace, patch_path)
+    if mode == "live":
+        if not prompt:
+            raise MiniMaxError("live mode requires a prompt")
+        return apply_live(workspace, prompt, records_dir)
+    raise MiniMaxError(f"unsupported mode: {mode}")
