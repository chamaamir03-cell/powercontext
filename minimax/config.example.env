# Optional settings for `python minimax/run.py apply --mode live`.
# Do not commit real credentials.
#
# Path to the MiniMax Code CLI. If unset, the module looks for `mcode` on PATH
# and for the npm global package at %APPDATA%/npm/node_modules/@minimax-ai/code.
# MCODE_BIN=/absolute/path/to/mcode
#
# The live command also requires `mcode login --region cn` first.
