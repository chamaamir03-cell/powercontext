ines_with_query_and_category():\n    result = search_products(\n        all_products(),\n        query=\"hub\",\n        category=\"accessory\",\n        min_price=3000,\n        max_price=6000,\n    )\n    assert skus(result) == [\"SKU-003\"]\n\n\ndef test_price_range_respects_sort_and_pagination():\n    result = search_products(\n        all_products(),\n        min_price=2000,\n        max_price=9000,\n        sort=\"price_asc\",\n        page=2,\n        page_size=2,\n    )\n    assert skus(result) == [\"SKU-003\", \"SKU-005\"]\n\n\ndef test_price_bounds_allow_zero_and_empty_results():\n    assert search_products(all_products(), min_price=0, max_price=0) == []\n\n\n@pytest.mark.parametrize(\n    (\"min_price\", \"max_price\"),\n    [\n        (6000, 5000),\n        (-1, 5000),\n        (0, -1),\n        (True, 5000),\n        (5000, False),\n        (10.5, 5000),\n        (\"5000\", 9000),\n    ],\n)\ndef test_invalid_price_bounds_raise_value_error(min_price, max_price):\n    with pytest.raises(ValueError):\n        search_products(all_products(), min_price=min_price, max_price=max_price)\n\n```\n\n### minimax/demo_project/tests/test_regression.py\n```python\nimport pytest\n\nfrom inventory import all_products, search_products\n\n\ndef skus(products):\n    return [product.sku for product in products]\n\n\ndef test_query_is_case_insensitive():\n    assert skus(search_products(all_products(), query=\"KEYBOARD\")) == [\"SKU-001\"]\n\n\ndef test_category_filter_preserves_relevance_order():\n    assert skus(search_products(all_products(), category=\"accessory\")) == [\n        \"SKU-004\",\n        \"SKU-003\",\n        \"SKU-006\",\n        \"SKU-008\",\n    ]\n\n\ndef test_price_ascending_sort():\n    assert skus(search_products(all_products(), sort=\"price_asc\")) == [\n        \"SKU-008\",\n        \"SKU-006\",\n        \"SKU-002\",\n        \"SKU-003\",\n        \"SKU-005\",\n        \"SKU-001\",\n        \"SKU-004\",\n        \"SKU-007\",\n    ]\n\n\ndef test_rating_sort():\n    assert skus(search_products(all_products(), sort=\"rating_desc\")) == [\n        \"SKU-007\",\n        \"SKU-001\",\n        \"SKU-004\",\n        \"SKU-002\",\n        \"SKU-003\",\n        \"SKU-006\",\n        \"SKU-005\",\n        \"SKU-008\",\n    ]\n\n\ndef test_pagination_keeps_existing_order():\n    assert skus(search_products(all_products(), page=2, page_size=3)) == [\n        \"SKU-002\",\n        \"SKU-003\",\n        \"SKU-006\",\n    ]\n\n\ndef test_blank_query_returns_everything():\n    assert len(search_products(all_products(), query=\"   \")) == 8\n\n\n@pytest.mark.parametrize(\"sort\", [\"newest\", \"\", \"PRICE_ASC\"])\ndef test_unknown_sort_raises_value_error(sort):\n    with pytest.raises(ValueError):\n        search_products(all_products(), sort=sort)\n\n\n@pytest.mark.parametrize((\"page\", \"page_size\"), [(0, 10), (1, 0), (-1, 5)])\ndef test_invalid_pagination_raises_value_error(page, page_size):\n    with pytest.raises(ValueError):\n        search_products(all_products(), page=page, page_size=page_size)\n\n```\n\n## Saved task state (PowerContext)\n```json\n{\n  \"completed\": [\n    \"materials_imported\",\n    \"context_built\"\n  ],\n  \"pending\": [\n    \"apply_patch\",\n    \"run_target_tests\",\n    \"run_regression_tests\"\n  ],\n  \"required_sources\": [\n    \"minimax/specs/inventory_search.md\",\n    \"minimax/demo_project/inventory/search.py\",\n    \"minimax/demo_project/tests/test_price_filter.py\",\n    \"minimax/demo_project/tests/test_regression.py\"\n  ],\n  \"status\": \"context_ready\",\n  \"task_id\": \"inventory-price-filter\",\n  \"updated_at\": \"2026-10-27T06:49:48.351069+00:00\",\n  \"validation\": {\n    \"regression\": \"pending\",\n    \"target\": \"pending\"\n  }\n}\n```\n\n## Required source paths\n- minimax/specs/inventory_search.md\n- minimax/demo_project/inventory/search.py\n- minimax/demo_project/tests/test_price_filter.py\n- minimax/demo_project/tests/test_regression.py",
